{
    "name": "nowip-api",
    "version": "1.1.0",
    "scripts": {
        "test": "echo \"Error: no test specified\" && exit 1",
        "dev": "bun run --watch src/index.ts",
        "db:generate": "bun scripts/db-utils && drizzle-kit generate --config=drizzle.config.ts",
        "db:migrate": "bun scripts/db-utils && drizzle-kit migrate --config=drizzle.config.ts",
        "db:push": "bun scripts/db-utils && drizzle-kit push --config=drizzle.config.ts",
        "start": "bun run src/index.ts"
    },
    "dependencies": {
        "@hono/standard-validator": "^0.4.0",
        "@scalar/hono-api-reference": "^0.11.16",
        "better-dns": "2.2.2",
        "drizzle-orm": "^0.45.2",
        "drizzle-zod": "^0.8.3",
        "hono": "^4.13.5",
        "hono-openapi": "^1.3.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "bun-types": "^1.4.0",
        "drizzle-kit": "^0.31.10"
    },
    "module": "src/index.ts"
}
